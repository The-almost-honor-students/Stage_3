\section*{Abstract}

\begin{infobox}[Project Summary]
This report presents the design, implementation, and deployment of a distributed book search platform built on a cluster architecture. The system leverages microservices, event-driven messaging, distributed caching, and high-availability patterns to create a scalable solution for indexing and searching digital books from Project Gutenberg. The architecture demonstrates practical applications of Big Data technologies including ActiveMQ Artemis clustering, Hazelcast distributed caching, and MongoDB for persistent storage.
\end{infobox}

\vspace{0.5cm}

\section*{Keywords}

\textbf{Docker} $\bullet$ \textbf{Kubernetes} $\bullet$ \textbf{Cluster Architecture} $\bullet$ \textbf{Microservices} $\bullet$ \textbf{ActiveMQ Artemis} $\bullet$ \textbf{High Availability} $\bullet$ \textbf{Hazelcast} $\bullet$ \textbf{MongoDB} $\bullet$ \textbf{Event-Driven Architecture} $\bullet$ \textbf{Distributed Systems} $\bullet$ \textbf{OpenTelemetry} $\bullet$ \textbf{Prometheus} $\bullet$ \textbf{Jaeger} $\bullet$ \textbf{Loki}

